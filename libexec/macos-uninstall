#!/usr/bin/env bash
# macos:summary=Unlink dotfiles and remove the engine (apps are left alone)
# macos:usage=macos uninstall [--dry-run] [--yes]
#
# Removes what the engine put in place for itself: the dotfile symlinks,
# the files `macos identity` generated, ~/.local/bin/macos and the engine
# clone; then restores the files the dotfiles had replaced (from
# ~/.local/state/macos/backup), so the shell keeps its Homebrew and
# ~/.local/bin setup. Deliberately kept: installed apps, macOS settings
# (including the Caps Lock LaunchAgent and Touch ID for sudo), GitHub's
# host keys in ~/.ssh/known_hosts, ~/.dotfiles, and ~/.local/state/macos.

# shellcheck source=lib/common.sh
. "${MACOS_ROOT:=$(cd -- "$(dirname -- "$0")/.." && pwd -P)}/lib/common.sh"
for _lib in run prompt lock profile dotfiles engine; do
  # shellcheck source=/dev/null
  . "$MACOS_ROOT/lib/$_lib.sh"
done
unset _lib

while [ $# -gt 0 ]; do
  case "$1" in
    -n | --dry-run) MACOS_DRY_RUN=1 ;;
    -y | --yes) MACOS_YES=1 ;;
    *) die "unknown option: $1 (see 'macos uninstall --help')" ;;
  esac
  shift
done
export MACOS_DRY_RUN MACOS_YES

engine_removable || die "$MACOS_ROOT does not look like an engine clone; refusing to remove it"
lock_acquire
dry_run && say "Dry run: nothing will be changed."

say "This unlinks your dotfiles and removes the engine at $MACOS_ROOT."
say "Apps, macOS settings, ~/.dotfiles and $MACOS_STATE (with backups) stay."
dry_run || confirm "Uninstall?" || { skip "nothing changed"; exit 0; }

dry_run || log_to_file

step "Dotfiles"
linked_paths=""
if [ -n "${MACOS_PROFILE:-}" ] && [ -d "$MACOS_DOTFILES/macos/profiles/base" ] && command -v stow >/dev/null 2>&1; then
  for p in $(stow_packages); do
    [ -d "$MACOS_DOTFILES/$p" ] && linked_paths="$linked_paths
$(package_files "$p")"
  done
  dotfiles_unlink
else
  skip "no linked dotfiles to remove"
fi
if [ -L "$HOME/.1password/agent.sock" ]; then
  run rm -f "$HOME/.1password/agent.sock"
fi
for f in "$HOME/.config/git/identity.gitconfig" "$HOME/.config/git/allowed_signers" \
  "$HOME/.ssh/config.d/macos-identity" "$HOME"/.ssh/macos-*.pub; do
  if [ -e "$f" ]; then
    run rm -f "$f"
  fi
done
if [ -d "$HOME/.config/git/identity.d" ]; then
  run rm -rf "$HOME/.config/git/identity.d"
fi
dotfiles_restore_backups "$linked_paths"
# Without the ssh config and agent link, gh over ssh would fail.
if command -v gh >/dev/null 2>&1 && [ "$(gh config get git_protocol -h github.com 2>/dev/null)" = ssh ]; then
  run gh config set git_protocol https -h github.com
fi

step "Engine"
if engine_cli_linked; then
  run rm -f "$MACOS_CLI_LINK"
fi
lock_release
run rm -rf "$MACOS_ROOT"
ok "engine removed"

if [ -d "$MACOS_STATE/backup" ]; then
  say "Files the dotfiles replaced are backed up in $MACOS_STATE/backup/; copy back what you need."
fi
say "Open a new terminal: your shell config is no longer linked."
