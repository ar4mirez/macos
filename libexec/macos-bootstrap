#!/usr/bin/env bash
# macos:summary=First-run setup of a new Mac (profile, security, apps, dotfiles, defaults, identity)
# macos:usage=macos bootstrap [--profile work|personal|base] [--hostname <name>] [--yes] [--dry-run]
# macos:bash=3
#
# Runs before Homebrew bash exists, so this file must stay bash-3.2-safe.
# Every phase is idempotent: re-running bootstrap resumes where it stopped.

# shellcheck source=lib/common.sh
. "${MACOS_ROOT:=$(cd -- "$(dirname -- "$0")/.." && pwd -P)}/lib/common.sh"
for _lib in run prompt lock pending sudo security brew repo gh profile dotfiles defaults system identity engine; do
  # shellcheck source=/dev/null
  . "$MACOS_ROOT/lib/$_lib.sh"
done
unset _lib

: "${MACOS_DOTFILES_REPO:=https://github.com/ar4mirez/macos-dotfiles.git}"
PROFILES="work personal base"

profile="${MACOS_PROFILE:-}"
hostname=""
while [ $# -gt 0 ]; do
  case "$1" in
    --profile) profile="${2:?--profile needs a value}"; shift 2 ;;
    --profile=*) profile="${1#*=}"; shift ;;
    --hostname) hostname="${2:?--hostname needs a value}"; shift 2 ;;
    --hostname=*) hostname="${1#*=}"; shift ;;
    -y | --yes) MACOS_YES=1; shift ;;
    -n | --dry-run) MACOS_DRY_RUN=1; shift ;;
    *) die "unknown option: $1 (see 'macos bootstrap --help')" ;;
  esac
done
export MACOS_YES MACOS_DRY_RUN

sudo_preflight
# On a fresh Mac, migrations (fixes for older setups) are marked done rather
# than run.
BOOTSTRAPPED="$MACOS_STATE/bootstrapped"
fresh_install=0
# Fresh = no bootstrap ever finished here and no migration has run: an
# interrupted first bootstrap still counts as fresh on its re-run.
if [ ! -f "$BOOTSTRAPPED" ] && [ ! -d "$MIGRATIONS_STATE" ]; then
  fresh_install=1
fi
failed=""

lock_acquire
dry_run || log_to_file
dry_run && say "Dry run: nothing will be changed (running under bash $BASH_VERSION)."

# --- 1. Profile and hostname --------------------------------------------------
step "Profile"
if [ -z "$profile" ]; then
  [ "$MACOS_YES" = 1 ] && die "--profile is required with --yes (one of: $PROFILES)"
  # shellcheck disable=SC2086
  choose profile "Which profile is this Mac?" $PROFILES
fi
case " $PROFILES " in
  *" $profile "*) ;;
  *) die "unknown profile '$profile' (one of: $PROFILES)" ;;
esac
if [ -z "$hostname" ]; then
  hostname="${MACOS_HOSTNAME:-}"
  [ -n "$hostname" ] || ask hostname "Computer name" "$(scutil --get ComputerName 2>/dev/null || true)"
fi
machine_env_set MACOS_PROFILE "$profile"
machine_env_set MACOS_HOSTNAME "$hostname"
machine_env_set MACOS_DOTFILES "$MACOS_DOTFILES"
ok "profile: $profile, computer name: $hostname"

# --- 2. Prerequisites ---------------------------------------------------------
step "Prerequisites"
brew_env
if command -v gh >/dev/null 2>&1; then
  skip "gh already installed"
else
  run brew install gh
fi
engine_link_cli

# --- 3. Security baseline -----------------------------------------------------
step "Security baseline"
sudo_keepalive
security_touchid
security_firewall
security_analytics
security_hostname "$hostname"

# --- 4. GitHub ----------------------------------------------------------------
step "GitHub"
gh_ensure_auth

# --- 5. Dotfiles clone --------------------------------------------------------
step "Dotfiles repo"
repo_sync "$MACOS_DOTFILES_REPO" "$MACOS_DOTFILES"
if ! dry_run && [ ! -d "$MACOS_DOTFILES/macos/profiles/base" ]; then
  die "$MACOS_DOTFILES has no macos/profiles/base; is $MACOS_DOTFILES_REPO the right repo?"
fi
if [ "$profile" != base ] && ! dry_run && [ ! -d "$MACOS_DOTFILES/macos/profiles/$profile" ]; then
  die "profile '$profile' not found in $MACOS_DOTFILES/macos/profiles"
fi

# --- 6. Apps ------------------------------------------------------------------
step "Apps"
if dry_run && [ ! -d "$MACOS_DOTFILES/macos/profiles/base" ]; then
  skip "dotfiles not cloned yet; would merge and install the $profile Brewfiles"
else
  merge_active_brewfile
  ok "merged Brewfile: $MERGED_BREWFILE"
  if ! brew_bundle_install "$MERGED_BREWFILE"; then
    warn "some apps failed to install (see above); continuing with the rest of the setup"
    failed="$failed apps"
  fi
  # pam-reattach may have just been installed; re-render sudo_local for it.
  security_touchid
  if grep -q '^cask "tailscale-app"' "$MERGED_BREWFILE" && ! "$TAILSCALE_CLI" status >/dev/null 2>&1; then
    pending_add tailscale "Open Tailscale, approve its system extension (System Settings → Privacy & Security) and log in"
  fi
  if grep -q '^mas ' "$MERGED_BREWFILE"; then
    pending_add appstore "Sign in to the App Store, then re-run 'macos apply' for Mac App Store apps"
  fi
fi

# --- 7. Dotfiles and runtimes --------------------------------------------------
step "Dotfiles"
if dry_run && [ ! -d "$MACOS_DOTFILES/macos/profiles/base" ]; then
  skip "dotfiles not cloned yet; would link the $profile packages"
elif ! command -v stow >/dev/null 2>&1 && dry_run; then
  skip "stow not installed yet; would link the $profile packages"
else
  dotfiles_link
fi
step "Runtimes (mise)"
mise_install

# --- 8. Defaults -----------------------------------------------------------------
step "Defaults"
if dry_run && [ ! -d "$MACOS_DOTFILES/macos/profiles/base" ]; then
  skip "dotfiles not cloned yet; would apply the $profile defaults"
else
  defaults_apply
  system_apply
fi

# --- 9. Identity ----------------------------------------------------------------
step "Identity"
if dry_run && [ ! -d "$MACOS_DOTFILES/macos/profiles/base" ]; then
  skip "dotfiles not cloned yet; would set up git identities and 1Password SSH"
else
  identity_apply
fi

# --- 10. Migrations and a health check --------------------------------------------
step "Migrations"
if [ "$fresh_install" = 1 ]; then
  migrations_mark_all
else
  migrations_run
fi

step "Health check"
if dry_run; then
  skip "would run 'macos doctor'"
else
  "$MACOS_ROOT/bin/macos" doctor || warn "'macos doctor' found problems (see above)"
fi
say "Open a new terminal window (or run: exec zsh -l) to load the linked shell config."
if [ -n "$failed" ]; then
  die "bootstrap finished with errors in:$failed; fix them and re-run 'macos bootstrap' (it resumes)"
fi
dry_run || date +%Y-%m-%dT%H:%M:%S | write_file "$BOOTSTRAPPED"
ok "bootstrap finished"
