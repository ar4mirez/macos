#!/usr/bin/env bash
# macos:summary=Converge apps, dotfiles, defaults and runtimes to the declared state
# macos:usage=macos apply [--prune] [--dry-run] [--yes]
#
# Idempotent: installs what is missing and never upgrades (see `macos
# upgrade`), so a second run changes nothing. --prune also uninstalls brew
# formulae, casks and taps that no active Brewfile declares, after asking.

# shellcheck source=lib/common.sh
. "${MACOS_ROOT:=$(cd -- "$(dirname -- "$0")/.." && pwd -P)}/lib/common.sh"
for _lib in run prompt lock pending sudo brew profile dotfiles defaults system identity; do
  # shellcheck source=/dev/null
  . "$MACOS_ROOT/lib/$_lib.sh"
done
unset _lib

prune=0
while [ $# -gt 0 ]; do
  case "$1" in
    --prune) prune=1 ;;
    -n | --dry-run) MACOS_DRY_RUN=1 ;;
    -y | --yes) MACOS_YES=1 ;;
    *) die "unknown option: $1 (see 'macos apply --help')" ;;
  esac
  shift
done
export MACOS_DRY_RUN MACOS_YES

require_profile
lock_acquire
dry_run || log_to_file
dry_run && say "Dry run: nothing will be changed."

step "Apps ($MACOS_PROFILE profile)"
brew_env
merge_active_brewfile

adoptable="$(brew_adoptable "$MERGED_BREWFILE")"
if [ -n "$adoptable" ]; then
  warn "installed by hand, so Homebrew can't install them over the top: $(echo "$adoptable" | tr '\n' ' ')"
  warn "run 'macos apps adopt' to hand them to Homebrew"
fi

failed=""
if ! brew_bundle_install "$MERGED_BREWFILE"; then
  warn "some apps failed to install (see above); continuing with the rest"
  failed="$failed apps"
fi

if [ "$prune" = 1 ]; then
  step "Prune"
  brew_prune "$MERGED_BREWFILE"
fi

step "Dotfiles"
dotfiles_link

step "Runtimes (mise)"
mise_install

step "Defaults"
defaults_apply
system_apply

# Never waits on 1Password here: without the agent this renders identities
# and leaves signing pending (see `macos identity`).
step "Identity"
MACOS_YES=1 identity_apply

if [ -n "$failed" ]; then
  die "apply finished with errors in:$failed"
fi
ok "apply finished"
