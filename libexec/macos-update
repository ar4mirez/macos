#!/usr/bin/env bash
# macos:summary=Update everything: engine, dotfiles, migrations, apply, then upgrade all packages and macOS
# macos:usage=macos update [--no-upgrade] [--dry-run] [--yes]
#
# One command for the whole Mac, like Omarchy's update. The engine only
# fast-forwards (it is never edited in place). The dotfiles repo is rebased
# with --autostash so uncommitted edits survive; a conflict aborts the
# rebase and stops. After migrations, the freshly pulled engine runs
# `macos apply`, then `macos upgrade` (Homebrew, App Store, mise, Neovim
# plugins, macOS updates), then your post-update hooks. --no-upgrade skips
# the upgrade.

# shellcheck source=lib/common.sh
. "${MACOS_ROOT:=$(cd -- "$(dirname -- "$0")/.." && pwd -P)}/lib/common.sh"
for _lib in run prompt lock profile repo engine; do
  # shellcheck source=/dev/null
  . "$MACOS_ROOT/lib/$_lib.sh"
done
unset _lib

apply_args=()
upgrade=1
while [ $# -gt 0 ]; do
  case "$1" in
    --no-upgrade) upgrade=0 ;;
    -n | --dry-run) MACOS_DRY_RUN=1; apply_args+=(--dry-run) ;;
    -y | --yes) MACOS_YES=1; apply_args+=(--yes) ;;
    *) die "unknown option: $1 (see 'macos update --help')" ;;
  esac
  shift
done
export MACOS_DRY_RUN MACOS_YES

require_profile
lock_acquire
dry_run || log_to_file
dry_run && say "Dry run: fetching to preview, but nothing will be changed."

# incoming <dir> [git -c flags...] — fetch, then list commits not yet merged.
incoming() {
  local dir="$1"
  shift
  git "$@" -C "$dir" fetch --quiet || { warn "could not fetch $dir"; return 0; }
  git -C "$dir" log --oneline 'HEAD..@{u}' 2>/dev/null || true
}

# update always updates the INSTALLED copies; development clones linked
# with `macos dev link` belong to you and are never pulled into.
step "Engine"
ENGINE="$MACOS_INSTALL_DIR"
if engine_is_dev; then
  skip "running your dev engine ($MACOS_ROOT): commit and pull it yourself; updating the installed one"
fi
if [ ! -d "$ENGINE/.git" ]; then
  warn "no installed engine clone at $ENGINE; skipping"
else
  new="$(incoming "$ENGINE" -c credential.helper=)"
  if [ -z "$new" ]; then
    skip "engine up to date ($(cat "$ENGINE/version"))"
  else
    printf '%s\n' "$new" | sed 's/^/    /' >&2
    run git -c credential.helper= -C "$ENGINE" merge --ff-only --quiet '@{u}' ||
      die "the engine at $ENGINE has local changes or diverged; it is not meant to be edited there (use a dev clone and 'macos dev link')"
    ok "engine updated to $(cat "$ENGINE/version")"
  fi
fi

step "Dotfiles"
DOTFILES="${MACOS_DOTFILES_INSTALLED:-$MACOS_DOTFILES}"
if dotfiles_is_dev; then
  skip "dotfiles are linked from your dev clone ($MACOS_DOTFILES): pull it yourself; updating the installed one"
fi
new="$(incoming "$DOTFILES" "${GIT_GH_ONLY[@]}")"
if [ -z "$new" ]; then
  skip "dotfiles up to date"
else
  printf '%s\n' "$new" | sed 's/^/    /' >&2
  if ! run git "${GIT_GH_ONLY[@]}" -C "$DOTFILES" rebase --autostash --quiet '@{u}'; then
    git -C "$DOTFILES" rebase --abort >/dev/null 2>&1 || true
    die "your local dotfiles commits conflict with the remote; resolve in $DOTFILES (nothing was applied)"
  fi
  # When re-applying the autostash conflicts, git still exits 0 and leaves
  # conflict markers in live (symlinked) dotfiles. The edits are safe in the
  # stash, so put the files back to the pulled version and stop.
  if ! dry_run && [ -n "$(git -C "$DOTFILES" ls-files -u)" ]; then
    if [ -n "$(git -C "$DOTFILES" stash list)" ]; then
      git -C "$DOTFILES" reset --hard --quiet HEAD
      die "your uncommitted dotfiles edits conflict with what was pulled. They are saved in the stash; the files are back to the pulled version so your shell keeps working. Resolve with: git -C $DOTFILES stash pop (fix conflicts, commit), then 'macos apply'. Nothing was applied."
    fi
    die "unresolved conflicts in $DOTFILES; resolve them, then 'macos update' (nothing was applied)"
  fi
  ok "dotfiles updated"
fi

step "Migrations"
migrations_run
engine_link_cli

# Hand over to the (possibly new) engine. exec keeps our pid, so release
# the lock first or apply would find it held by itself.
lock_release
if [ "${_MACOS_DIED_OWNER:-}" = "$$" ]; then
  rm -f "$_MACOS_DIED_FLAG"
fi
unset _MACOS_DIED_FLAG _MACOS_DIED_OWNER
# Upgrading on top of a failed apply would build on a Mac that isn't in its
# declared state; stop, as Omarchy's update does when its packages fail.
"$MACOS_ROOT/bin/macos" apply ${apply_args[@]+"${apply_args[@]}"} || exit
rc=0
if [ "$upgrade" = 1 ]; then
  "$MACOS_ROOT/bin/macos" upgrade ${apply_args[@]+"${apply_args[@]}"} || rc=$?
fi
# post-update hooks run from the freshly pulled engine, even when part of the
# upgrade failed (Omarchy runs them once packages and migrations are done).
dry_args=()
dry_run && dry_args=(--dry-run)
"$MACOS_ROOT/bin/macos" hook run post-update ${dry_args[@]+"${dry_args[@]}"} || true
exit "$rc"
