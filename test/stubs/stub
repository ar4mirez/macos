#!/bin/bash
# Test double for system tools (defaults, brew, sudo, ...). test/run.sh symlinks
# it under each tool's name, first on PATH. It records the call and never
# touches the system.
#
#   STUB_LOG            file that receives "<tool> <args...>" per call
#   STUB_LOG_ENV        space-separated variable names to append to each
#                       logged line as [NAME=value] when set
#   STUB_<TOOL>_OUT     text to print on stdout (tool name uppercased, - → _)
#   STUB_<TOOL>_RC      exit code (default 0; `defaults read` defaults to 1,
#                       i.e. "key does not exist")
# OUT/RC can be narrowed to the first one to three arguments, most specific
# first: STUB_BREW_BUNDLE_CHECK_RC, then STUB_BREW_BUNDLE_RC, then
# STUB_BREW_RC. Arguments are uppercased with non-alphanumerics → _
# (so `info --cask` is STUB_BREW_INFO___CASK_OUT).

tool="${0##*/}"
var="$(printf '%s' "$tool" | tr '[:lower:]-' '[:upper:]_')"

line="$tool $*"
for _e in ${STUB_LOG_ENV:-}; do
  if [ -n "${!_e:-}" ]; then
    line="$line [$_e=${!_e}]"
  fi
done
printf '%s\n' "$line" >>"${STUB_LOG:-/dev/null}"

# uname answers per flag, so boot.sh's platform check can be exercised.
if [ "$tool" = uname ]; then
  case "${1:-}" in
    -s) echo "${STUB_UNAME_S:-Darwin}" ;;
    -m) echo "${STUB_UNAME_M:-arm64}" ;;
    *) echo "${STUB_UNAME_S:-Darwin}" ;;
  esac
  exit 0
fi

# brew reports analytics as disabled whenever HOMEBREW_NO_ANALYTICS is set,
# regardless of the stored setting; mimic that so tests catch being fooled.
if [ "$tool" = brew ] && [ "${1:-} ${2:-}" = "analytics state" ]; then
  if [ -n "${HOMEBREW_NO_ANALYTICS:-}" ] || [ -n "${STUB_BREW_ANALYTICS_OFF:-}" ]; then
    echo "InfluxDB analytics are disabled."
  else
    echo "InfluxDB analytics are enabled."
  fi
  exit 0
fi

_up() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_'; }
a1="$(_up "${1:-}")"
a2="$(_up "${2:-}")"
a3="$(_up "${3:-}")"

# pick <suffix> — name of the most specific STUB_* variable that is set.
pick() {
  local v
  for v in "STUB_${var}_${a1}_${a2}_${a3}_$1" "STUB_${var}_${a1}_${a2}_$1" "STUB_${var}_${a1}_$1" "STUB_${var}_$1"; do
    if [ -n "${!v+x}" ]; then
      echo "$v"
      return
    fi
  done
  echo "STUB_${var}_$1"
}
out_var="$(pick OUT)"
rc_var="$(pick RC)"

if [ -n "${!out_var:-}" ]; then
  printf '%s\n' "${!out_var}"
fi

# STUB_<TOOL>_RC_SEQ="1 1 0": exit codes for successive calls (the last one
# repeats), e.g. a tool that starts failing and then succeeds.
seq_var="STUB_${var}_RC_SEQ"
if [ -n "${!seq_var:-}" ]; then
  seq_file="${STUB_LOG:-/tmp/stub}.seq.$var"
  [ -f "$seq_file" ] || printf '%s\n' ${!seq_var} >"$seq_file"
  rc="$(head -n 1 "$seq_file")"
  if [ "$(wc -l <"$seq_file")" -gt 1 ]; then
    tail -n +2 "$seq_file" >"$seq_file.tmp" && mv "$seq_file.tmp" "$seq_file"
  fi
  exit "$rc"
fi

rc="${!rc_var:-}"
if [ -z "$rc" ]; then
  rc=0
  if [ "$tool" = defaults ] && [ "${1:-}" = read ]; then
    rc=1
  fi
fi
exit "$rc"
